# MongoDB Atlas (cluster 8.1+ richiesto per $rankFusion)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=Rag_PDF
MONGODB_COLLECTION=pdf_chunks
MONGODB_GRIDFS_BUCKET=pdf_files

# Nomi indici Atlas Search
VECTOR_INDEX_NAME=pdf_chunks_vector_idx
SEARCH_INDEX_NAME=pdf_chunks_text_idx

# Voyage API:
#  - Chiavi "al-..." (create in Atlas) → VOYAGE_API_BASE=https://ai.mongodb.com/v1
#  - Chiavi "pa-..." (dashboard.voyageai.com) → VOYAGE_API_BASE=https://api.voyageai.com/v1
VOYAGE_API_KEY=
VOYAGE_API_BASE=https://ai.mongodb.com/v1
VOYAGE_EMBED_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-2.5
# Modalità embedding:
#   "auto"    → autoEmbed gestito da Atlas (no chiamate dall'app)
#   "manual"  → Python chiama Voyage /embeddings (modello da VOYAGE_EMBED_MODEL)
#   "context" → Python chiama Voyage /contextualizedembeddings con
#               chunk locali page-aware contestualizzati insieme (voyage-context-4, preview)
EMBED_MODE=auto
# Dimensione vettore — usata SOLO in modalità manual.
VOYAGE_EMBED_DIMENSIONS=2048
# voyage-context-4 (usato SOLO in modalità context). 1024 dim, supporta anche 256/512/2048.
# In modalità context l'app conserva i chunk locali e i metadati pagina;
# Voyage genera ogni vettore usando il contesto degli altri chunk dello stesso documento.
VOYAGE_CONTEXT_MODEL=voyage-context-4
VOYAGE_CONTEXT_DIMENSIONS=1024

# System prompt del LLM — vive in `prompts/system_prompt.txt`.
# Modifica direttamente quel file per cambiare il comportamento del LLM
# (più comodo che editare una stringa multi-riga in .env).
# Override opzionali da .env:
#   LLM_SYSTEM_PROMPT="testo inline..."   → ha precedenza assoluta
#   LLM_SYSTEM_PROMPT_FILE=path/to.txt   → path alternativo al default

# LLM provider: "anthropic" | "ollama" | "gemini"
LLM_PROVIDER=anthropic

# Anthropic (usato se LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama locale (usato se LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:latest
# Modello vision per image description (es: llava:7b, llama3.2-vision)
OLLAMA_VISION_MODEL=llava:7b

# Google Gemini (usato se LLM_PROVIDER=gemini) — chiave da Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
INGESTION_DUPLICATE_POLICY=skip
INGESTION_PIPELINE_VERSION=v3
CHUNKER_VERSION=token-window-v2

# Retrieval
RETRIEVAL_TOP_K=50
RETRIEVAL_NUM_CANDIDATES_MULTIPLIER=10
RETRIEVAL_NUM_CANDIDATES_MIN=100
RERANK_TOP_N=8
RERANK_RELEVANCE_THRESHOLD=0.15

# OCR (path Tesseract; lascia vuoto se è già nel PATH)
TESSERACT_CMD=
