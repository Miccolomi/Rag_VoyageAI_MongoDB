# ═════════════════════════════════════════════════════════════════════════════
#  RAG Demo · MongoDB + Voyage AI — configurazione
# ═════════════════════════════════════════════════════════════════════════════
#  1. Copia questo file:   cp .env.example .env
#  2. Compila le sezioni 1, 2 e 3 (le uniche obbligatorie).
#  3. Il file .env contiene le chiavi: resta sul tuo computer, non va mai su
#     GitHub (è già escluso in .gitignore). Questo file di esempio invece sì:
#     non scriverci mai chiavi vere.
#
#  Le righe che iniziano con "#" sono facoltative e mostrano il valore
#  predefinito già usato dal codice (src/config.py). Togli il "#" solo se vuoi
#  cambiarlo.
# ═════════════════════════════════════════════════════════════════════════════


# ─── 1. MongoDB Atlas · obbligatorio ─────────────────────────────────────────
# Cluster MongoDB 8.1 o successivo: servono $rankFusion e $rerank.
MONGODB_URI=mongodb+srv://utente:password@cluster.xxxxx.mongodb.net/

# Database, collection dei passaggi e bucket GridFS dei file originali.
# MONGODB_DB=rag
# MONGODB_COLLECTION=pdf_chunks
# MONGODB_GRIDFS_BUCKET=pdf_files


# ─── 2. Voyage AI · obbligatorio per manual, context e multimodal ────────────
# Con la sola modalità auto e il reranking nativo la chiave non serve:
# embedding e reranking li esegue Atlas.
#   chiave "al-..." (creata in Atlas)        → VOYAGE_API_BASE=https://ai.mongodb.com/v1
#   chiave "pa-..." (dashboard di Voyage AI) → VOYAGE_API_BASE=https://api.voyageai.com/v1
#   con una chiave "al-" usa l'endpoint indicato in Atlas (per esempio quello
#   europeo, https://eu.ai.mongodb.com/v1, se il progetto è in Europa).
VOYAGE_API_KEY=
# VOYAGE_API_BASE=https://ai.mongodb.com/v1

# Modelli. Il modello di auto è quello scritto nell'indice vettoriale di Atlas.
# VOYAGE_EMBED_MODEL=voyage-4-large            # auto e manual
# VOYAGE_EMBED_DIMENSIONS=2048                 # manual: deve coincidere con l'indice
# VOYAGE_CONTEXT_MODEL=voyage-context-4        # context
# VOYAGE_CONTEXT_DIMENSIONS=1024
# VOYAGE_MULTIMODAL_MODEL=voyage-multimodal-3.5
# VOYAGE_RERANK_MODEL=rerank-3

# native    → $rerank dentro la pipeline di MongoDB (consigliato)
# voyage_api → l'applicazione chiama l'API di Voyage (serve VOYAGE_API_KEY)
# RERANK_BACKEND=native


# ─── 3. Modello che scrive la risposta · obbligatorio ────────────────────────
# Scegli un provider e compila solo la sua parte qui sotto.
#   anthropic | gateway | gemini | ollama
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# AI Gateway aziendale MongoDB (API OpenAI Responses): solo dalla rete aziendale.
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_API_KEY_2=                        # di riserva, se la prima viene rifiutata
# AI_GATEWAY_MODEL=modello-test

# Google Gemini (chiave da Google AI Studio)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Ollama sul computer locale
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral-nemo:latest
# OLLAMA_NUM_CTX=8192                          # contesto in token, uguale per tutte le chiamate
# OLLAMA_KEEP_ALIVE=30m                        # quanto resta caricato il modello

# Lunghezza massima della risposta, in token.
# LLM_MAX_TOKENS=1500

# Istruzioni al modello: si modificano in prompts/system_prompt.txt.
# In alternativa: un altro file, oppure il testo qui (ha la precedenza).
# LLM_SYSTEM_PROMPT_FILE=prompts/system_prompt.txt
# LLM_SYSTEM_PROMPT=


# ─── 4. Ricerca agentica · facoltativo ───────────────────────────────────────
# Provider e modello per le decisioni dell'agente (piano e valutazione delle
# evidenze). Vuoti = gli stessi della risposta.
# AGENT_LLM_PROVIDER=
# ANTHROPIC_AGENT_MODEL=
# AI_GATEWAY_AGENT_MODEL=
# OLLAMA_AGENT_MODEL=

# Passaggi recuperati per ogni ricerca e passaggi riordinati quando l'agente
# unisce più ricerche.
# AGENT_TOP_K=20
# AGENT_UNION_RERANK=30


# ─── 5. Ricerca (Query) · facoltativo ────────────────────────────────────────
# Modalità di ricerca al primo avvio: auto | manual | context | multimodal.
# Poi vale l'ultima scelta fatta in Query o in Ricerca agentica.
# EMBED_MODE=auto

# Candidati per motore, passaggi dati al modello e soglia minima di pertinenza
# (punteggio del reranker da 0 a 1: sotto la soglia il modello non viene chiamato).
# RETRIEVAL_TOP_K=50
# RERANK_TOP_N=8
# RERANK_RELEVANCE_THRESHOLD=0.15


# ─── 6. Caricamento dei documenti · facoltativo ──────────────────────────────
# Dimensione e sovrapposizione dei chunk, in token. In modalità manual si
# possono cambiare anche dalla pagina Upload, per ogni caricamento.
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=64

# Se il documento è già caricato: skip | replace | append.
# INGESTION_DUPLICATE_POLICY=skip

# OCR delle pagine scansionate: percorso di Tesseract, se non è già nel PATH.
# TESSERACT_CMD=
# Percorso di LibreOffice: serve per le pagine visive di Word e PowerPoint.
# OFFICE_CONVERTER=


# ─── 7. Cifratura lato client (CSFLE) · facoltativo ──────────────────────────
# Cifra la prima domanda di ogni sessione della Ricerca agentica.
# Preparazione:  .venv/bin/python -m src.field_encryption setup
# La chiave master è un file FUORI dal progetto: non va mai nel repository.
# Senza il file la demo funziona e salva il campo in chiaro.
# Due computer sullo stesso cluster: copia lo stesso file su entrambi.
# CSFLE_MASTER_KEY_PATH=~/.config/rag-demo/csfle-master-key.bin
# CSFLE_KEY_VAULT_NAMESPACE=encryption.__keyVault
# CSFLE_KEY_ALT_NAME=rag-demo-sessioni


# ─── 8. Avanzate · di solito non si toccano ──────────────────────────────────
# Nomi degli indici in Atlas.
# SEARCH_INDEX_NAME=pdf_chunks_text_idx
# VECTOR_INDEX_NAME=pdf_chunks_vector_idx
# VECTOR_INDEX_MANUAL_NAME=pdf_chunks_manual_idx
# VECTOR_INDEX_CONTEXT_NAME=pdf_chunks_context_idx
# VECTOR_INDEX_MULTIMODAL_NAME=pdf_chunks_multimodal_idx

# $vectorSearch: candidati esaminati = max(TOP_K × moltiplicatore, minimo).
# RETRIEVAL_NUM_CANDIDATES_MULTIPLIER=10
# RETRIEVAL_NUM_CANDIDATES_MIN=100

# Pesi di $rankFusion: equal = ogni motore peso 1 (consigliato);
# balanced = il testo pesa quanto tutti i rami semantici insieme.
# HYBRID_TEXT_WEIGHT_MODE=equal
# Unisce le copie dello stesso passaggio caricato in più modalità.
# HYBRID_DEDUP=true

# Versioni salvate in ogni passaggio, per sapere con quale pipeline è stato creato.
# INGESTION_PIPELINE_VERSION=v4
# CHUNKER_VERSION=token-window-v2
